<Window x:Class="MacTun.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacTun" Height="780" Width="980"
        MinHeight="680" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing"
        FontFamily="Segoe UI" Background="#F3F5F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Foreground" Value="#303846" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE2EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusBadge" Width="12" Height="44" CornerRadius="6" Background="#8A94A6" />
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="StatusText" Text="正在读取服务状态…" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetailText" Text="" Margin="0,4,0,0" Foreground="#667085" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="3" x:Name="RefreshButton" Content="刷新" Click="RefreshButton_Click" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="White">
            <TabItem Header="代理与网络">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="SOCKS5 代理" />
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" x:Name="ProxyTextBox" ToolTip="例如 socks5://127.0.0.1:7890" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="可信 DNS" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TrustedDnsTextBox" ToolTip="留空时保留系统 DNS 路径" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Wintun 名称" />
                        <TextBox Grid.Row="2" Grid.Column="4" x:Name="DeviceTextBox" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="物理网卡（可选）" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="InterfaceTextBox" ToolTip="留空自动检测" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="IPv4 网关（可选）" />
                        <TextBox Grid.Row="4" Grid.Column="4" x:Name="GatewayTextBox" ToolTip="留空自动检测" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="MTU" />
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="MtuTextBox" />
                        <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="日志级别" />
                        <ComboBox Grid.Row="6" Grid.Column="4" x:Name="LogLevelComboBox">
                            <ComboBoxItem Content="debug" />
                            <ComboBoxItem Content="info" />
                            <ComboBoxItem Content="warn" />
                            <ComboBoxItem Content="error" />
                            <ComboBoxItem Content="silent" />
                        </ComboBox>

                        <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" x:Name="Ipv6CheckBox" Content="接管 IPv6" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="8" Grid.Column="3" Grid.ColumnSpan="2" x:Name="AutoBypassCheckBox" Content="自动发现本地代理远端节点" VerticalAlignment="Center" />

                        <CheckBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TcpOnlyCheckBox" Content="TCP-only 兼容模式" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="10" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="服务启动方式" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="StartupComboBox" Width="170" SelectedValuePath="Tag">
                                <ComboBoxItem Content="手动（推荐）" Tag="manual" IsSelected="True" />
                                <ComboBoxItem Content="自动（延迟启动）" Tag="automatic" />
                            </ComboBox>
                        </StackPanel>

                        <Border Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="5" Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="6" Padding="12">
                            <TextBlock Foreground="#596579" TextWrapping="Wrap"
                                       Text="服务以 LocalSystem 运行，但仍连接本机 SOCKS5。若代理只在用户登录后启动，请保持“手动”；只有代理本身也是系统服务时才使用自动启动。" />
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="应用分流">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="列表内的可执行文件及其子进程走 SOCKS5；列表为空时是全局模式。" Foreground="#596579" />
                    <ListBox Grid.Row="2" x:Name="ApplicationsListBox" SelectionMode="Extended" BorderBrush="#D7DDE6" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button Content="添加 .exe" Click="AddApplicationButton_Click" />
                        <Button Content="移除选中" Click="RemoveApplicationButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="绕行与日志">
                <Grid Margin="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.42*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.58*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Text="代理节点绕行（每行一个域名、IP 或 CIDR）" />
                    <TextBlock Grid.Column="2" Text="服务日志（自动刷新，最多显示末尾 128 KiB）" />
                    <TextBox Grid.Row="2" Grid.Column="0" x:Name="BypassTextBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" />
                    <TextBox Grid.Row="2" Grid.Column="2" x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" Background="#10151D" Foreground="#DDE7F5" BorderThickness="0" />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="InstallButton" Content="安装/更新服务" Click="InstallButton_Click" />
                <Button x:Name="UninstallButton" Content="卸载服务" Click="UninstallButton_Click" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="OperationText" VerticalAlignment="Center" Foreground="#667085" TextAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="保存配置" Click="SaveButton_Click" />
                <Button x:Name="StartButton" Content="启动" Click="StartButton_Click" Background="#1677FF" Foreground="White" />
                <Button x:Name="RestartButton" Content="保存并重启" Click="RestartButton_Click" />
                <Button x:Name="StopButton" Content="停止" Click="StopButton_Click" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
